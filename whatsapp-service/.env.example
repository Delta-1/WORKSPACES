PORT=8787
WHATSAPP_SERVICE_SECRET=

SUPABASE_URL=
# service_role key (Project Settings -> API), NOT the anon key — this
# process has no logged-in app user, so it needs to bypass RLS to write
# contacts/conversations/messages. Never expose this key to a browser.
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=

# Endereço público do site (ex.: https://seu-app.vercel.app). Necessário para a
# Nina oferecer os modelos do Estúdio: ela lê o catálogo em /api/studio/models,
# manda a imagem de prévia de /modelos/*.jpg e pede o arquivo montado em
# /api/studio/render. Sem isso ela continua atendendo, só não oferece o Estúdio.
APP_URL=
