<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071018"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="WORKSPACE"
            android:textColor="#6EE7B7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing=".22" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Acesso Remoto"
            android:textColor="#F8FAFC"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Compartilhe este código com quem vai prestar o suporte."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/accessCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/code_background"
            android:gravity="center"
            android:padding="22dp"
            android:text="--- --- ---"
            android:textColor="#6EE7B7"
            android:textSize="31sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing=".1" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Registrando este celular…"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:text="Compartilhar tela"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/controlButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Ativar controle por toque"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/folderButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Escolher pasta compartilhada"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/folderLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Nenhuma pasta compartilhada"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/info_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONTROLE VISÍVEL E SEGURO"
                android:textColor="#67E8F9"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing=".12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="O Android mostra um aviso enquanto a tela estiver compartilhada. Você pode encerrar pela notificação ou por este aplicativo a qualquer momento."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
